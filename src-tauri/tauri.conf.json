{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shell Xplore",
  "version": "../package.json",
  "identifier": "cn.ofis.shx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shell Xplore",
        "width": 1280,
        "height": 820,
        "minWidth": 1280,
        "minHeight": 560,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 13,
          "y": 21.5
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCOUNGOUJFMDMxRTI4ODcKUldTSEtCNER2dm1jUzdyY2tEQzNBN01jYXErUEZlQVJRVTZrQ3FzRzRtQUlNaS9QcktyMkh3UEcK",
      "endpoints": [
        "https://github.com/ZhangGuangHuiCoder/shx/releases/latest/download/latest.json"
      ]
    }
  }
}
